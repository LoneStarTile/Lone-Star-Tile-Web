{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon-48x48.png"
    },
    {
      "source": "/((?!assets/|favicon|apple-touch-icon|site\\.webmanifest|.*\\.(png|webp|jpg|jpeg|ico|svg|css|js|json|txt|xml)).*)",
      "destination": "/index.html"
    }
  ]
}
